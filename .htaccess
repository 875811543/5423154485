# ============================================================
#  Dezinsect Corse — Configuration Apache
# ============================================================

Options -Indexes
DirectoryIndex index.html

# ------------------------------------------------------------
#  1. Réécriture d'URL
# ------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Supprimer le www ET forcer HTTPS en une seule redirection.
  # Cette regle passe AVANT celle qui force HTTPS : elle redirige deja vers
  # https, donc http://www/page arrive a destination en un seul saut. Dans
  # l'ordre inverse, la regle HTTPS reutilisait %{HTTP_HOST} tel quel,
  # conservait le www, et il fallait une seconde redirection.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Forcer HTTPS pour le domaine sans www
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # ----------------------------------------------------------
  #  Redirections des anciennes URLs (migration builder -> site statique)
  #
  #  Liste etablie le 1er septembre 2026 a partir du site alors en ligne sur
  #  dezinsect-corse.fr, faute d'acces a Search Console. Trois signaux publics
  #  ont ete croises et donnent les memes seize adresses :
  #    - /sitemap.xml du site en ligne
  #    - les liens internes de sa page d'accueil, menus compris
  #    - /robots.txt, qui ne declare qu'un sitemap et ne bloque aucun chemin
  #  Six de ces adresses n'existent plus ici ; les six sont redirigees.
  #
  #  Reserve : une adresse indexee mais liee nulle part resterait invisible
  #  depuis l'exterieur. Si Search Console devient accessible, comparer sa
  #  liste « Indexees » a celles-ci et completer.
  #  Format : RewriteRule ^ancienne-url/?$ /nouvelle-url [R=301,L]
  # ----------------------------------------------------------

  # Page supprimée du site
  RewriteRule ^a-propos/?$ /services-anti-nuisibles [R=301,L]

  # Anciennes pages de zones, fusionnées en 3 pages régionales
  RewriteRule ^anti-nuisibles-costa-verde-plaine-orientale/?$ /anti-nuisibles-costa-verde [R=301,L]
  RewriteRule ^anti-nuisibles-bastia(-grand-bastia)?/?$ /anti-nuisibles-costa-verde [R=301,L]
  RewriteRule ^anti-nuisibles-balagne/?$ /anti-nuisible-corte [R=301,L]
  RewriteRule ^anti-nuisibles-(centre-corse|corte)/?$ /anti-nuisible-corte [R=301,L]
  RewriteRule ^anti-nuisibles-(grand-)?ajaccio/?$ /anti-nuisibles-grand-ajaccio-porto-vecchio [R=301,L]
  RewriteRule ^anti-nuisibles-(porto-vecchio|bonifacio|extreme-sud|sud-corse)/?$ /anti-nuisibles-grand-ajaccio-porto-vecchio [R=301,L]

  # Adresses relevees dans le sitemap du site actuellement en ligne, le
  # 1er septembre 2026. Elles n'existent plus dans cette version : sans ces
  # regles, la bascule les renverrait en 404 et perdrait leur anciennete.
  # Les deux premieres ont un equivalent exact service + ville.
  RewriteRule ^frelons-porto-vecchio/?$ /destruction-nid-guepes-porto-vecchio [R=301,L]
  RewriteRule ^termites-grand-ajaccio/?$ /traitement-termites-ajaccio [R=301,L]
  RewriteRule ^frelons-casinca/?$ /destruction-nid-guepes-bastia [R=301,L]
  RewriteRule ^plaine-orientale-frelons-termites/?$ /anti-nuisibles-costa-verde [R=301,L]
  # Ecrit au singulier sur l'ancien site, la regle plurielle ne l'attrapait pas.
  RewriteRule ^anti-nuisible-balagne(-et-nebbio)?/?$ /anti-nuisible-corte [R=301,L]

  # Filet de sécurité : toute ancienne URL de zone non listée ci-dessus
  # atterrit sur le hub plutôt qu'en 404.
  # Les deux conditions sont indispensables : sans elles, cette règle
  # capturerait aussi les pages de zones actuelles, qui existent bien.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html !-f
  RewriteRule ^anti-nuisibles?-.+$ /zones-dintervention [R=301,L]

  # Supprimer la barre finale sur les pages (pas sur les vrais dossiers).
  # Indispensable depuis que les liens internes sont sans extension : sur
  # /deratisation/, l'URL de base devient /deratisation/ et tous les liens
  # relatifs de la page pointeraient une cible inexistante.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Rediriger /index.html vers / en une seule fois. Sans cette regle, la
  # generique ci-dessous le menait a /index, puis ^index/?$ a / : deux 301
  # en chaine. Elle doit rester AVANT la generique.
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # Rediriger /page.html -> /page (évite le contenu dupliqué)
  RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Rediriger /index -> /
  RewriteRule ^index/?$ / [R=301,L]

  # Une demande sur un vrai dossier devient une vraie 404, qui declenche la
  # page 404 du site. Sans cela, Options -Indexes fait repondre 403 et
  # Apache sert sa propre page d'erreur : fond blanc, « Forbidden », et la
  # signature du serveur. Pour le visiteur il n'y a pas de page a cette
  # adresse — ce n'est pas une question de droit d'acces.
  # ^.+$ exige au moins un caractere : la racine, elle, reste servie.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^.+$ - [R=404,L]

  # Servir /page.html quand on demande /page
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ------------------------------------------------------------
#  2. Page d'erreur personnalisée
# ------------------------------------------------------------
ErrorDocument 404 /404.html
# Filet : tout autre refus retombe sur la meme page plutot que sur celle
# d'Apache, qui expose la signature du serveur.
ErrorDocument 403 /404.html

# ------------------------------------------------------------
#  3. Compression GZIP / Brotli
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  # text/javascript est indispensable : selon la version d'Apache, un .js
  # part sous ce type plutot que sous application/javascript. Sans lui, le
  # JS risque d'etre servi non compresse.
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript text/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

<IfModule mod_brotli.c>
  # meme liste que deflate ci-dessus : elle etait plus complete.
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript text/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/manifest+json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/xml
</IfModule>

# ------------------------------------------------------------
#  4. Mise en cache navigateur
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg           "access plus 1 year"
  ExpiresByType image/png            "access plus 1 year"
  ExpiresByType image/webp           "access plus 1 year"
  ExpiresByType image/svg+xml        "access plus 1 year"
  ExpiresByType image/x-icon         "access plus 1 year"
  ExpiresByType text/css             "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/html            "access plus 0 seconds"
</IfModule>

# ------------------------------------------------------------
#  Fichiers de travail : jamais servis
# ------------------------------------------------------------
# AGENTS.md decrit la construction du site, son hebergement et ses
# faiblesses connues ; tools/ contient le script de verification. La
# checklist de mise en ligne dit de les exclure de l'archive, mais cela
# suppose de s'en souvenir. Si l'archive part complete, le serveur refuse
# de lui-meme.
#
# Au premier niveau volontairement : « Require all denied » ne depend pas
# de mod_headers et RedirectMatch depend de mod_alias. Un garde-fou place
# sous <IfModule mod_headers.c> disparaitrait justement le jour ou la
# configuration se degrade.
<FilesMatch "\.(md|log|bak|orig|sh)$">
  Require all denied
</FilesMatch>
<IfModule mod_alias.c>
  RedirectMatch 404 ^/tools/
  RedirectMatch 404 ^/\.git
</IfModule>

<IfModule mod_headers.c>
  # Images et polices : un an de cache, mais SANS « immutable ».
  # « immutable » interdit au navigateur de revalider, meme sur
  # rechargement force. Cela ne se justifie que pour des URL portant une
  # empreinte, comme /app.4f2a91.css. Ici seuls la CSS et le JS ont un ?v= :
  # les images et les polices sont servies sans empreinte dans leur URL.
  #
  # Le WebP du logo a deja ete reencode une fois pendant ce projet. Avec
  # « immutable », un visiteur deja venu aurait garde la version fautive
  # pendant un an, rechargement compris.
  #
  # REGLE : pour remplacer une image ou une police, RENOMMER le fichier.
  # Changer l'URL est le seul moyen fiable de forcer le renouvellement.
  # Le controle « orphelins » signalera l'ancien fichier reste inutilise.
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>

  # ----------------------------------------------------------
  #  5. En-têtes de sécurité
  # ----------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # includeSubDomains volontairement absent. Une fois cet en-tete vu, le
  # navigateur refuse le HTTP en clair pendant un an — et avec
  # includeSubDomains, sur tous les sous-domaines aussi. Un sous-domaine
  # sans HTTPS cree plus tard (webmail, outil, site de test) deviendrait
  # inatteignable pour les visiteurs deja venus, et annuler suppose de
  # servir max-age=0 puis d'attendre que chacun repasse.
  # A rajouter une fois que TOUS les sous-domaines sont en HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"

  # ----------------------------------------------------------
  #  Politique de securite du contenu — MODE RAPPORT
  # ----------------------------------------------------------
  # Passee en mode BLOQUANT le 4 septembre 2026, apres zero violation constatee
  # en Report-Only sur cinq pages -- accueil, deratisation, rat-noir, questions
  # frequentes et contact -- carte cliquee, pages parcourues et les six
  # raccourcis de la FAQ sollicites un par un. Un onclick ne viole rien tant
  # qu'il ne s'execute pas : mesurer au repos aurait donne un rapport rassurant
  # et faux.
  #
  # Elle ne porte AUCUN 'unsafe-inline'. Le JavaScript en ligne a ete retire du
  # site plutot que permis, et le controle « pas-de-js-en-ligne » empeche qu'il
  # revienne par une page creee plus tard.
  #
  # Ce qu'elle autorise, et pourquoi :
  #   connect-src  api.web3forms.com  — le formulaire de contact y poste
  #   frame-src    www.google.com     — la carte, creee par main.js au clic
  #   form-action  api.web3forms.com  — le formulaire en soumission classique
  #   img-src      data:              — les images encodees dans le CSS
  #
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; frame-src https://www.google.com; form-action 'self' https://api.web3forms.com; base-uri 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>

# ------------------------------------------------------------
#  6. Types MIME
# ------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest

  # Le manifeste du site s'appelle manifest.json, pas .webmanifest : la
  # ligne ci-dessus ne le couvre donc pas et il partait en
  # application/json. La regle de cache qui vise application/manifest+json
  # ne s'appliquait pas non plus. On vise ce seul fichier, pour ne pas
  # requalifier les autres .json.
  <IfModule mod_headers.c>
    <Files "manifest.json">
      Header set Content-Type "application/manifest+json"
    </Files>
  </IfModule>
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddCharset UTF-8 .html .css .js .json .xml
</IfModule>
# --------------------------------------------------
#  Fichiers de travail non publics
# --------------------------------------------------
<FilesMatch "^(AGENTS\.md|\.gitignore|\.gitattributes)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/tools/